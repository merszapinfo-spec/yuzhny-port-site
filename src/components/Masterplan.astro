---
import { Image } from 'astro:assets';
import { images } from '../data/images.js';
import { zones } from '../data/site.js';
---

<section class="section section--dark masterplan" id="masterplan">
  <div class="container masterplan__head">
    <div>
      <span class="eyebrow" data-reveal>Генплан</span>
      <h2 class="h-section" data-split>Город <b>на воде</b></h2>
    </div>
    <p class="lead" data-reveal>Нажмите на точку, чтобы узнать, из чего складывается район: жилые кварталы, деловой центр и культурный центр вдоль 2 км набережной.</p>
  </div>

  <div class="container">
    <div class="plan" data-plan data-reveal>
      <Image src={images['masterplan']} alt="Аэрофото генплана Южного Порта" widths={[828, 1280, 1920, 2800]} sizes="(max-width: 1440px) 100vw, 1440px" class="plan__img" />

      {zones.map((z, i) => (
        <button
          class:list={['plan__pin', { 'is-active': i === 0 }]}
          style={`left:${z.x}%;top:${z.y}%`}
          type="button"
          data-pin={i}
          aria-label={z.title}
        >
          <span class="plan__dot"></span>
          <span class="plan__tag">{z.title}</span>
        </button>
      ))}

      <div class="plan__card" data-plan-card aria-live="polite">
        {zones.map((z, i) => (
          <div class:list={['plan__info', { 'is-active': i === 0 }]} data-info={i}>
            <span class="plan__num">0{i + 1} / 0{zones.length}</span>
            <h3>{z.title}</h3>
            <p class="plan__figure">{z.figure}</p>
            <p>{z.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .masterplan__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .masterplan__head .lead {
    margin: 0;
    max-width: 26em;
    font-size: 17px;
  }

  .plan {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
  }
  .plan__img {
    width: 100%;
    height: auto;
  }
  .plan::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--ink-a35), transparent 40%);
    pointer-events: none;
  }

  .plan__pin {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    cursor: pointer;
    transform: translate(-11px, -50%);
  }
  .plan__dot {
    position: relative;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 0 0 6px var(--white-a25);
    transition: background 0.3s, box-shadow 0.3s;
  }
  .plan__dot::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid var(--white);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(2.4); opacity: 0; }
  }
  .plan__tag {
    padding: 6px 12px;
    background: var(--ink-a75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: 2px;
    transition: background 0.3s, color 0.3s;
  }
  .plan__pin:hover .plan__dot,
  .plan__pin.is-active .plan__dot {
    background: var(--river);
    box-shadow: 0 0 0 6px var(--river-a35);
  }
  .plan__pin.is-active .plan__tag {
    background: var(--river);
    color: var(--ink);
  }

  .plan__card {
    position: absolute;
    z-index: 3;
    right: 24px;
    bottom: 24px;
    width: min(380px, calc(100% - 48px));
    min-height: 210px;
    padding: 28px;
    background: var(--white-a94);
    color: var(--text);
    border-radius: 4px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .plan__info {
    display: none;
  }
  .plan__info.is-active {
    display: block;
    animation: cardIn 0.6s var(--ease);
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  .plan__num {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--river-deep);
  }
  .plan__info h3 {
    margin: 8px 0 4px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .plan__figure {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--navy);
  }
  .plan__info p:last-child {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .masterplan__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .plan {
      overflow: visible;
    }
    .plan::after {
      display: none;
    }
    .plan__img {
      border-radius: 6px;
    }
    .plan__tag {
      display: none;
    }
    .plan__card {
      position: relative;
      right: auto;
      bottom: auto;
      width: 100%;
      margin-top: 16px;
      min-height: 0;
    }
  }
</style>
